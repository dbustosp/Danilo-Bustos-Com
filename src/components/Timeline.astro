---
/**
 * La trayectoria como línea de tiempo: los años a la izquierda, un filete
 * vertical con un punto por organización, y los cargos colgando a la derecha.
 *
 * El filete es la segunda excepción a "sin bordes" (§9), junto con la regla
 * de la cabecera. Las dos son lo mismo: un pelo de --rule que estructura, no
 * una caja que encierra. Sin sombras, sin fondos, sin acento —el acento
 * sigue siendo solo para enlaces— y sin nada que rodee al contenido.
 */
import { type Org, type Position, orgStart, orgEnd, DETAIL_CUTOFF_YEAR } from '../lib/resume';
import { formatMonthYear, formatYear, isoDate } from '../lib/dates';
import { SITE } from '../config/site';

interface Props {
  orgs: Org[];
}

const { orgs } = Astro.props;

/*
 * "2015 – 2017"; un solo año cuando empieza y acaba en el mismo; y el mes
 * más una raya suelta cuando la etapa sigue abierta.
 */
const range = (start: Date, end?: Date) => {
  if (!end) return `${formatMonthYear(start, SITE.lang)} –`;
  const from = formatYear(start, SITE.lang);
  const to = formatYear(end, SITE.lang);
  return from === to ? from : `${from} – ${to}`;
};

const span = (p: Position) => range(p.start, p.end);

const hasDetail = (p: Position) => Boolean(p.summary?.length || p.bullets?.length);

/*
 * Los cargos anteriores a la mudanza se muestran plegados, no recortados.
 * Se mira el inicio, no el fin: lo que separa las dos etapas es dónde
 * empezó cada cargo. Y en UTC, porque las fechas se construyen en UTC y
 * getFullYear() usa la hora local: en Atlanta, un 1 de enero se leería
 * como el año anterior.
 */
const isFolded = (p: Position) => p.start.getUTCFullYear() < DETAIL_CUTOFF_YEAR;
---

<ol class="timeline">
  {
    orgs.map((org) => (
      <li>
        <p class="dates">
          <time datetime={isoDate(orgStart(org))}>{range(orgStart(org), orgEnd(org))}</time>
        </p>

        <div class="entry">
          <p class="org">{org.org}</p>
          {org.place && <p class="place small muted">{org.place}</p>}

          <ol class="positions">
            {org.positions.map((position) => (
              <li>
                <p class="title">{position.title}</p>
                {/* Con un solo cargo, la fecha ya la dice la organización. */}
                {org.positions.length > 1 && (
                  <p class="span small muted">{span(position)}</p>
                )}
                {hasDetail(position) &&
                  (isFolded(position) ? (
                    <details class="detail">
                      <summary class="small muted">Details</summary>
                      {position.summary?.map((paragraph) => <p class="summary">{paragraph}</p>)}
                      {position.bullets && (
                        <ul class="bullets">
                          {position.bullets.map((bullet) => (
                            <li>{bullet}</li>
                          ))}
                        </ul>
                      )}
                    </details>
                  ) : (
                    <>
                      {position.summary?.map((paragraph) => <p class="summary">{paragraph}</p>)}
                      {position.bullets && (
                        <ul class="bullets">
                          {position.bullets.map((bullet) => (
                            <li>{bullet}</li>
                          ))}
                        </ul>
                      )}
                    </>
                  ))}
              </li>
            ))}
          </ol>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline,
  .positions {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline {
    position: relative;
  }

  /*
   * El filete. Arranca y termina en el primer y el último punto, no en los
   * bordes de la lista: una línea de tiempo empieza donde empieza el tiempo.
   */
  .timeline::before {
    content: '';
    position: absolute;
    left: 7.5rem;
    top: 0.62em;
    bottom: 0.62em;
    width: 1px;
    background: var(--rule);
  }

  .timeline > li {
    position: relative;
    display: grid;
    grid-template-columns: 7rem 1fr;
    column-gap: var(--space-3);
    align-items: baseline;
  }

  .timeline > li + li {
    margin-top: var(--space-5);
  }

  /* Un punto por organización, no por cargo: el hito es el cambio de casa. */
  .timeline > li::before {
    content: '';
    position: absolute;
    left: 7.5rem;
    top: 0.5em;
    width: 7px;
    height: 7px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--muted);
  }

  .dates {
    font-family: var(--font-heading);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .entry {
    padding-left: var(--space-2);
  }

  .org {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .place {
    margin-top: 0.1rem;
  }

  .positions {
    margin-top: var(--space-2);
  }

  .positions > li + li {
    margin-top: var(--space-2);
  }

  /* Título y años en dos columnas: los años forman su propia columna limpia. */
  .positions > li {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-2);
    align-items: baseline;
  }

  .span {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .detail {
    grid-column: 1 / -1;
  }

  /* Sin caja y sin triángulo del sistema: solo una palabra que se pulsa. */
  .detail > summary {
    list-style: none;
    cursor: pointer;
    width: max-content;
    margin-top: 0.35rem;
  }

  .detail > summary::-webkit-details-marker {
    display: none;
  }

  .detail > summary::before {
    content: '+';
    display: inline-block;
    width: 1em;
    color: var(--rule);
  }

  .detail[open] > summary::before {
    content: '–';
  }

  .detail > summary:hover {
    color: var(--text);
  }

  .summary,
  .bullets {
    grid-column: 1 / -1;
    margin-top: 0.35rem;
    max-width: 34em;
    color: var(--muted);
  }

  .summary + .summary {
    margin-top: 0.5rem;
  }

  /*
   * Viñetas con raya al margen: marcan la lista sin el punto redondo de una
   * lista de prosa, que aquí competiría con los puntos de la línea de tiempo.
   */
  .bullets {
    padding: 0;
    list-style: none;
  }

  .bullets > li {
    padding-left: 1.1em;
    text-indent: -1.1em;
  }

  .bullets > li + li {
    margin-top: 0.35rem;
  }

  .bullets > li::before {
    content: '–';
    margin-right: 0.5em;
    color: var(--rule);
  }

  @media (max-width: 40rem) {
    /* Sin dos columnas no hay dónde anclar el filete: se retira entero. */
    .timeline::before,
    .timeline > li::before {
      display: none;
    }

    .timeline > li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .dates {
      text-align: left;
    }

    .entry {
      padding-left: 0;
    }
  }
</style>

---
/**
 * La trayectoria, en dos columnas: años a la izquierda, organización a la
 * derecha, y los cargos colgando de ella.
 *
 * Sin raíl, sin puntos y sin tarjetas. El canal que separa las dos columnas
 * lo hace el aire y la alineación —fechas a la derecha contra contenido a la
 * izquierda—, no una línea dibujada: §9 pide jerarquía solo con tamaño y
 * espacio. Las medidas son las de PostList, ensanchadas para que quepa un
 * rango de años.
 */
import { type Org, type Position, orgStart, orgEnd } from '../lib/resume';
import { formatMonthYear, formatYear, isoDate } from '../lib/dates';
import { SITE } from '../config/site';

interface Props {
  orgs: Org[];
}

const { orgs } = Astro.props;

/*
 * "2015 – 2017"; un solo año cuando empieza y acaba en el mismo; y el mes
 * más una raya suelta cuando la etapa sigue abierta.
 */
const range = (start: Date, end?: Date) => {
  if (!end) return `${formatMonthYear(start, SITE.lang)} –`;
  const from = formatYear(start, SITE.lang);
  const to = formatYear(end, SITE.lang);
  return from === to ? from : `${from} – ${to}`;
};

const span = (p: Position) => range(p.start, p.end);
---

<ol class="timeline">
  {
    orgs.map((org) => (
      <li>
        <p class="dates">
          <time datetime={isoDate(orgStart(org))}>{range(orgStart(org), orgEnd(org))}</time>
        </p>

        <div>
          <p class="org">{org.org}</p>
          {org.place && <p class="place small muted">{org.place}</p>}

          <ol class="positions">
            {org.positions.map((position) => (
              <li>
                <p class="title">
                  {position.title}
                  {/* Con un solo cargo, la fecha ya la dice la organización. */}
                  {org.positions.length > 1 && <span class="span small muted"> · {span(position)}</span>}
                </p>
                {position.summary && <p class="summary">{position.summary}</p>}
              </li>
            ))}
          </ol>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline,
  .positions {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline > li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-2);
    align-items: baseline;
  }

  .timeline > li + li {
    margin-top: var(--space-4);
  }

  .dates {
    font-family: var(--font-heading);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .org {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .place {
    margin-top: 0.1rem;
  }

  .positions {
    margin-top: var(--space-2);
  }

  .positions > li + li {
    margin-top: var(--space-2);
  }

  .span {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .summary {
    margin-top: 0.2rem;
    max-width: 36em;
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .timeline > li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .dates {
      text-align: left;
    }
  }
</style>

---
/**
 * Subnavegación del blog: todo y las tres categorías. Es la única forma en
 * que las categorías aparecen en la navegación; nunca en la URL de un post.
 */
import { CATEGORIES, CATEGORY_IDS, categoryUrl, type CategoryId } from '../lib/categories';

interface Props {
  current?: CategoryId;
}

const { current } = Astro.props;

const items = [
  { href: '/writing', label: 'All', id: undefined as CategoryId | undefined },
  ...CATEGORY_IDS.map((id) => ({ href: categoryUrl(id), label: CATEGORIES[id].label, id })),
];
---

<nav aria-label="Categories" class="category-nav">
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} class="link-quiet" aria-current={item.id === current ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .category-nav {
    margin-bottom: var(--space-4);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  a {
    color: var(--muted);
  }

  a:hover,
  a[aria-current='page'] {
    color: var(--text);
  }

  a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
  }
</style>

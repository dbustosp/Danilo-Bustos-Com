---
/**
 * Cabecera: solo navegación, alineada a la derecha. Sin logotipo, sin
 * eslogan y sin el nombre repetido —la home ya lo lleva como título, y en
 * el resto de páginas el nombre vive en el <title> de la pestaña y en el
 * pie. Lo que queda es lo único que hace falta: a dónde se puede ir.
 */
import { SITE } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

/*
 * "/" solo coincide consigo mismo: con startsWith, la raíz sería la página
 * actual en todas las rutas del sitio.
 */
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="site-header container" lang={SITE.lang}>
  <nav aria-label="Primary">
    <ul>
      {
        SITE.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="link-quiet"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: flex-end;
    padding-block: var(--space-3);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  @media (max-width: 40rem) {
    nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

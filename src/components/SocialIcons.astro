---
/**
 * LinkedIn y GitHub como marcas, no como texto. Van en la home, que es
 * donde alguien que acaba de descubrir el nombre quiere comprobar quién
 * es antes de leer nada.
 *
 * Los SVG van en línea: son dos siluetas, y meterlas en el HTML evita dos
 * peticiones para 500 bytes. Sin caja y sin fondo (§9); el color es el
 * apagado del sitio y se aclara al pasar por encima, igual que la
 * navegación y el conmutador de tema.
 *
 * Un enlace vacío en SITE.social no se muestra, como en el pie.
 */
import { SITE } from '../config/site';

const links = [
  { href: SITE.social.linkedin, label: 'LinkedIn' },
  { href: SITE.social.github, label: 'GitHub' },
].filter((link) => link.href);
---

{
  links.length > 0 && (
    <ul class="social-icons">
      {links.map((link) => (
        <li>
          <a href={link.href} rel="me" aria-label={link.label} title={link.label}>
            {link.label === 'LinkedIn' ? (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
              </svg>
            ) : (
              <svg viewBox="0 0 16 16" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social-icons {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    color: var(--muted);
    line-height: 0;
  }

  a:hover {
    color: var(--text);
  }
</style>

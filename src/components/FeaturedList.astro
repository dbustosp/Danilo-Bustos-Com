---
/**
 * Los ensayos definitorios, en clave de portada. Es lo primero que ve un
 * visitante nuevo.
 *
 * Se usa SOLO en la home. El índice de /writing lista todo con PostList:
 * cuando las dos páginas usaban esto, la segunda no enseñaba nada nuevo.
 *
 * No todos pesan igual, que es lo que separa una portada de una lista: el
 * más reciente se lleva el titular grande y la entradilla, y el resto queda
 * en dos líneas. Así caben todos sin bajar y aparece jerarquía donde antes
 * había bloques idénticos.
 *
 * Cuál es el principal no se configura: getFeaturedPosts() viene ordenado
 * por fecha, así que es el primero. Un campo menos que mantener a mano.
 *
 * Todo con escala y aire, sin caja (§9), y dentro de la columna de lectura:
 * una rejilla de tarjetas a 66ch daría ~320px por columna y ahí un titular
 * en Newsreader se parte en cuatro líneas.
 */
import type { Post } from '../lib/posts';
import { postUrl } from '../lib/posts';
import { SITE } from '../config/site';
import { CATEGORIES, categoryUrl } from '../lib/categories';
import { formatMonthYear, isoDate } from '../lib/dates';
import { ui } from '../lib/i18n';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="featured">
  {
    posts.map((post, index) => (
      <li class:list={{ lead: index === 0 }}>
        {/* La categoría va arriba: en una audiencia mixta, saber si algo es
            técnico o personal tiene que llegar antes que el titular. */}
        <p class="eyebrow section-label">
          <a href={categoryUrl(post.data.category)} class="link-quiet">
            {CATEGORIES[post.data.category].label}
          </a>
          {' · '}
          <time datetime={isoDate(post.data.date)}>
            {formatMonthYear(post.data.date, post.data.lang)}
          </time>
          {post.data.lang !== SITE.lang && <span> · {ui(post.data.lang).langLabel}</span>}
          {post.data.draft && <span class="draft"> · {ui(post.data.lang).draft}</span>}
        </p>

        <h3>
          <a href={postUrl(post)} class="link-quiet" lang={post.data.lang}>
            {post.data.title}
          </a>
        </h3>

        {/* La entradilla es lo que distingue al principal del resto. */}
        {index === 0 && (
          <p class="description" lang={post.data.lang}>
            {post.data.description}
          </p>
        )}
      </li>
    ))
  }
</ul>

<style>
  .featured {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Los compactos son una lista y van juntos. */
  li + li {
    margin-top: var(--space-3);
  }

  /* Corte entre la pieza principal y la lista. */
  li.lead + li {
    margin-top: var(--space-4);
  }

  /*
   * Hereda .section-label pero baja de peso: el rótulo de la sección
   * ("FEATURED ESSAYS") y el antetítulo de cada entrada quedan a un palmo,
   * y con el mismo grosor se leerían como el mismo nivel.
   */
  .eyebrow {
    font-weight: 400;
    margin-bottom: 0.4rem;
  }

  h3 {
    font-size: 1.25rem;
  }

  li.lead h3 {
    font-size: 1.875rem;
    max-width: 18em;
  }

  .description {
    margin-top: 0.75rem;
    max-width: 34em;
  }

  .draft {
    font-style: italic;
    text-transform: none;
  }

  @media (max-width: 40rem) {
    li.lead h3 {
      font-size: 1.5rem;
    }
  }
</style>

---
/**
 * Pie: los únicos enlaces sociales del sitio. LinkedIn, GitHub, X y RSS.
 * Instagram y Facebook son el círculo personal y no aparecen.
 */
import { SITE } from '../config/site';

const links = [
  { href: SITE.social.linkedin, label: 'LinkedIn' },
  { href: SITE.social.github, label: 'GitHub' },
  { href: SITE.social.twitter, label: 'X' },
  { href: '/rss.xml', label: 'RSS' },
].filter((link) => link.href);

const year = new Date().getFullYear();
---

<footer class="site-footer container">
  <ul class="social" aria-label="Links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} rel={link.href.startsWith('http') ? 'me' : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="small muted">
    © {year} {SITE.name} · <a href={SITE.repo} class="link-quiet">Site source</a>
  </p>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
</style>

---
/**
 * Esqueleto de todas las páginas: <head>, cabecera, columna de lectura y pie.
 *
 * Las páginas solo aportan título, descripción y contenido. Todo lo que es
 * común (fuentes, tema, metadatos, navegación, enlaces del pie) vive aquí
 * una sola vez.
 */
import { Font } from 'astro:assets';
import { SITE } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo, { type ArticleMeta } from '../components/Seo.astro';
import ThemeInit from '../components/ThemeInit.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
  /** Título de la pestaña. Se le añade el nombre del sitio salvo en la home. */
  title: string;
  /** Descripción propia de la página. Nunca heredada por defecto. */
  description: string;
  /** Imagen de vista previa para redes (1200×630). Por defecto, la del sitio. */
  image?: string;
  imageAlt?: string;
  /** Tipo Open Graph; los ensayos son "article". */
  type?: 'website' | 'article';
  article?: ArticleMeta;
  /** Datos estructurados de la página. */
  jsonLd?: Record<string, unknown>[];
  /** Excluye la página de los buscadores (páginas de trabajo, como /lab). */
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og/default.png',
  imageAlt,
  type,
  article,
  jsonLd,
  noindex = false,
} = Astro.props;
const isHome = Astro.url.pathname === '/';
const pageTitle = isHome ? title : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <Seo {title} {description} {canonical} {image} {imageAlt} {type} {article} {jsonLd} {noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <ThemeInit />
    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-inter" preload={[{ style: 'normal' }]} />
    <slot name="head" />
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <Header />
    <main id="content" class="container">
      <slot />
    </main>
    <Footer />
    {/* Vercel Analytics: sin cookies, sin banner. Solo en producción. */}
    {import.meta.env.PROD && <Analytics />}
  </body>
</html>

<style>
  main {
    flex: 1;
    padding-block: var(--space-4) var(--space-6);
  }

  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -100%;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    color: var(--text);
    z-index: 10;
  }

  .skip-link:focus {
    top: var(--space-2);
  }
</style>

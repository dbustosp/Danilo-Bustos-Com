---
/**
 * Laboratorio: página de trabajo para elegir en pantalla lo que no se puede
 * juzgar imaginando. Tipografía de títulos y color de acento.
 *
 * No se enlaza desde la navegación, lleva noindex y queda fuera del sitemap.
 * Cuando la decisión esté tomada, esta carpeta se borra junto con las
 * familias "laboratorio" de astro.config.mjs y package.json.
 */
import { Font } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

const headingFonts = [
  { label: 'Newsreader (base)', family: 'var(--font-newsreader)', note: 'Serif con carácter pero sobria.' },
  { label: 'Source Serif 4', family: 'var(--font-source-serif)', note: 'Muy institucional y clásica.' },
  {
    label: 'Charter',
    family: "Charter, 'Bitstream Charter', 'Sitka Text', Georgia, serif",
    note: 'Sobria, excelente para texto largo. No está en Google Fonts: se muestra solo si el sistema la tiene (macOS e iOS la traen); si no, cae a Georgia.',
  },
  { label: 'Fraunces', family: 'var(--font-fraunces)', note: 'Más carácter y personalidad.' },
  { label: 'Inter para todo', family: 'var(--font-inter)', note: 'La opción más neutra: sin serif.' },
];

const accents = [
  { label: 'Azul marino apagado (base)', light: '#2b4a6f', dark: '#9db9db' },
  { label: 'Azul del Seno de Última Esperanza', light: '#1f5f7a', dark: '#86bdd4' },
  { label: 'Gris piedra de las Torres del Paine', light: '#55606b', dark: '#a9b3bd' },
];

const sample = {
  h2: 'Los agentes son el capítulo presente, no la carrera',
  p: 'A nivel junior hay que probar que sabes construir. A nivel staff eso ya se asume; lo que se evalúa es el criterio: cómo piensas y cómo decides bajo restricciones. El criterio no se demuestra con capturas de pantalla, se demuestra escribiendo.',
};
---

<BaseLayout title="Laboratorio" description="Página de prueba para elegir tipografía y color de acento." noindex>
  <Fragment slot="head">
    <Font cssVariable="--font-source-serif" />
    <Font cssVariable="--font-fraunces" />
  </Fragment>

  <h1>Laboratorio</h1>
  <p class="muted intro">
    Página de trabajo, sin enlaces desde el sitio. Sirve para comparar en pantalla las alternativas de
    tipografía de títulos y de color de acento. Cambia el modo claro/oscuro arriba para ver ambas versiones.
  </p>

  <section aria-labelledby="tipografia">
    <h2 id="tipografia">Tipografía de títulos</h2>
    <p class="muted">El cuerpo es siempre Inter, salvo en la última opción.</p>
    {
      headingFonts.map((font) => (
        <article class="specimen" style={`--font-heading: ${font.family}`}>
          <p class="label">
            <strong>{font.label}</strong> · {font.note}
          </p>
          <h1 class="specimen-h1">
            {SITE.name}
            <span class="domains">{SITE.domains}</span>
          </h1>
          <h2 class="specimen-h2">{sample.h2}</h2>
          <p class="specimen-p" style={font.label.startsWith('Inter') ? 'font-family: var(--font-inter)' : ''}>
            {sample.p} <a href="#tipografia">Un enlace de muestra</a>.
          </p>
        </article>
      ))
    }
  </section>

  <section aria-labelledby="acento">
    <h2 id="acento">Color de acento</h2>
    <p class="muted">El acento se usa solo en los enlaces. Cada opción muestra el par claro/oscuro.</p>
    {
      accents.map((accent) => (
        <article class="specimen swatch" style={`--accent-light: ${accent.light}; --accent-dark: ${accent.dark}`}>
          <p class="label">
            <strong>{accent.label}</strong> · claro <code>{accent.light}</code> · oscuro <code>{accent.dark}</code>
          </p>
          <p class="specimen-p">
            {sample.p.slice(0, 120)}… <a href="#acento">Así se ve un enlace</a> dentro de un párrafo, y{' '}
            <a href="#acento">otro enlace</a> más adelante.
          </p>
        </article>
      ))
    }
  </section>
</BaseLayout>

<style>
  .intro {
    margin-top: var(--space-2);
  }

  section {
    margin-top: var(--space-5);
  }

  section > h2 + p {
    margin-top: var(--space-1);
  }

  .specimen {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .label {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }

  .label code {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .specimen-h1 {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
  }

  .domains {
    font-size: 0.66em;
    font-weight: 400;
    color: var(--muted);
  }

  .specimen-h2 {
    margin-top: var(--space-3);
  }

  .specimen-p {
    margin-top: var(--space-2);
  }

  .swatch {
    --accent: var(--accent-light);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .swatch {
      --accent: var(--accent-dark);
    }
  }

  :root[data-theme='dark'] .swatch {
    --accent: var(--accent-dark);
  }
</style>

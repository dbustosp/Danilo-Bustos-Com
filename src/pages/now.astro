---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../lib/dates';

const entry = await getEntry('pages', 'now');
if (!entry) throw new Error('Falta src/content/pages/now.md');
const { Content } = await render(entry);
const { title, description, updated } = entry.data;
---

<BaseLayout title={title} description={description} image="/og/now.png">
  <header class="page-header">
    <h1>What I'm working on now</h1>
  </header>

  <div class="prose">
    <Content />
  </div>

  {
    updated && (
      <p class="updated small muted">
        Updated on <time datetime={isoDate(updated)}>{formatDate(updated)}</time>.
      </p>
    )
  }
</BaseLayout>

<style>
  .updated {
    margin-top: var(--space-5);
  }
</style>

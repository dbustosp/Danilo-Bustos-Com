---
/**
 * Índice del blog: todo lo publicado, en orden cronológico.
 *
 * Sin sección de destacados: eso lo hace la home. Cuando esta página los
 * repetía arriba, con el mismo componente y el mismo aspecto, ir de la
 * portada aquí no enseñaba nada nuevo. La home promociona, el índice lista.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout
  title="Writing"
  description="Essays on engineering, artificial intelligence adoption in the enterprise, and personal notes."
  image="/og/writing.png"
>
  <header class="page-header">
    <h1>Writing</h1>
  </header>

  <CategoryNav />

  {
    posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="muted">No essays published yet.</p>
    )
  }
</BaseLayout>

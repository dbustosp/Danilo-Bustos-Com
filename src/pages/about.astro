---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { personJsonLd } from '../lib/jsonld';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Falta src/content/pages/about.md');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} image="/og/about.png" jsonLd={[personJsonLd()]}>
  <header class="page-header">
    <h1>{entry.data.title}</h1>
  </header>

  <div class="prose">
    <Content />
  </div>

  <section class="contact" aria-labelledby="contact">
    <h2 id="contact" class="section-label">Contact</h2>
    <p>
      {
        SITE.email ? (
          <>
            Email me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or reach me on{' '}
            <a href={SITE.social.linkedin}>LinkedIn</a>.
          </>
        ) : (
          <>
            The best way to reach me is on <a href={SITE.social.linkedin}>LinkedIn</a>.
          </>
        )
      }
      {' '}The code I publish is on <a href={SITE.social.github}>GitHub</a>.
    </p>
    <p class="small muted">
      The <a href="/cv">CV</a> is on a separate page.
    </p>
  </section>
</BaseLayout>

<style>
  .contact {
    margin-top: var(--space-5);
  }

  .contact p + p {
    margin-top: var(--space-2);
  }
</style>

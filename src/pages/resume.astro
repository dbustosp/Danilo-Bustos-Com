---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import { SITE } from '../config/site';
import { ORGS } from '../lib/resume';

const entry = await getEntry('pages', 'resume');
if (!entry) throw new Error('Falta src/content/pages/resume.md');
const { Content } = await render(entry);
const { title, description } = entry.data;
---

<BaseLayout title={title} description={description} image="/og/resume.png">
  <header class="page-header">
    <h1>{title}</h1>
  </header>

  <div class="prose">
    <Content />
  </div>

  <section class="experience" aria-labelledby="experience">
    <h2 id="experience" class="section-label">Experience</h2>
    <Timeline orgs={ORGS} />
  </section>

  <p class="note small muted">
    Full profile on <a href={SITE.social.linkedin}>LinkedIn</a>.
  </p>
</BaseLayout>

<style>
  .experience {
    margin-top: var(--space-5);
  }

  .note {
    margin-top: var(--space-5);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SITE_TITLE } from '../config/site';
---

<BaseLayout title={SITE_TITLE} description={SITE.shortBio}>
  <section class="hero">
    <h1>
      {SITE.name}
      <span class="domains">{SITE.domains}</span>
    </h1>
    <p class="tagline">{SITE.tagline}</p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-4) var(--space-5);
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
  }

  .domains {
    font-size: 0.66em;
    font-weight: 400;
    color: var(--muted);
  }

  .tagline {
    margin-top: var(--space-3);
    font-size: 1.125em;
    max-width: 34em;
  }
</style>

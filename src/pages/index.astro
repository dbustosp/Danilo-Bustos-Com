---
/**
 * Home. El flujo: encabezado de tres dominios, los ensayos destacados
 * (la prueba del criterio), en qué está trabajando ahora, y una línea sobre
 * él con el enlace a la bio completa.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedList from '../components/FeaturedList.astro';
import { SITE, SITE_TITLE } from '../config/site';
import { getFeaturedPosts, getPosts } from '../lib/posts';
import { personJsonLd, websiteJsonLd } from '../lib/jsonld';

// Si todavía no hay destacados, se muestran los más recientes.
const featured = await getFeaturedPosts();
const essays = featured.length > 0 ? featured : (await getPosts()).slice(0, 4);
---

<BaseLayout title={SITE_TITLE} description={SITE.shortBio} jsonLd={[personJsonLd(), websiteJsonLd()]}>
  {/*
    La home es una portada, no un resumen del sitio. No lleva encabezado
    propio —el nombre y el territorio los pone la cabecera— ni secciones
    "About" y "Now": las dos repetían páginas que ya están en el menú.
    Queda lo que el sitio es (§1): el tagline y lo que se escribe.
  */}
  <p class="tagline">{SITE.tagline}</p>
  <p class="more"><a href="/about">Full bio and contact</a></p>

  {
    essays.length > 0 && (
      <section class="block" aria-labelledby="essays">
        <h2 id="essays" class="section-label">
          {featured.length > 0 ? 'Featured essays' : 'Latest essays'}
        </h2>
        <FeaturedList posts={essays} />
        <p class="more">
          <a href="/writing">All writing</a>
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .tagline {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    line-height: 1.4;
    max-width: 30em;
  }

  .block {
    margin-top: var(--space-6);
  }


  .more {
    margin-top: var(--space-2);
    font-size: 0.9375rem;
  }
</style>

---
/**
 * Home. El flujo: encabezado de tres dominios, los ensayos destacados
 * (la prueba del criterio), en qué está trabajando ahora, y una línea sobre
 * él con el enlace a la bio completa.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedList from '../components/FeaturedList.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { SITE, SITE_TITLE } from '../config/site';
import { getFeaturedPosts, getPosts } from '../lib/posts';
import { personJsonLd, websiteJsonLd } from '../lib/jsonld';

// Si todavía no hay destacados, se muestran los más recientes.
const featured = await getFeaturedPosts();
const essays = featured.length > 0 ? featured : (await getPosts()).slice(0, 4);
---

<BaseLayout title={SITE_TITLE} description={SITE.shortBio} jsonLd={[personJsonLd(), websiteJsonLd()]}>
  {/* Sin encabezado propio: el nombre y el territorio ya los lleva la cabecera. */}
  <p class="tagline">{SITE.tagline}</p>
  <SocialIcons />

  {
    essays.length > 0 && (
      <section class="block" aria-labelledby="essays">
        <h2 id="essays" class="section-label">
          {featured.length > 0 ? 'Featured essays' : 'Latest essays'}
        </h2>
        <FeaturedList posts={essays} />
        <p class="more">
          <a href="/writing">All writing</a>
        </p>
      </section>
    )
  }

  <section class="block" aria-labelledby="now">
    <h2 id="now" class="section-label">What I'm working on now</h2>
    <p class="lead">{SITE.now}</p>
    <p class="more"><a href="/now">More about what I do now</a></p>
  </section>

  <section class="block" aria-labelledby="about">
    <h2 id="about" class="section-label">About</h2>
    <p class="lead">{SITE.shortBio}</p>
    <p class="more"><a href="/about">Full bio and contact</a></p>
  </section>
</BaseLayout>

<style>
  /* Separados del tagline, pero sin soltarse hacia la sección siguiente,
     que está a --space-6. */
  .tagline + :global(ul) {
    margin-top: var(--space-4);
  }

  .tagline {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    line-height: 1.4;
    max-width: 30em;
  }

  .block {
    margin-top: var(--space-6);
  }

  .lead {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    line-height: 1.4;
    max-width: 30em;
  }

  .more {
    margin-top: var(--space-2);
    font-size: 0.9375rem;
  }
</style>
